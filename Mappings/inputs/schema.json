    },
    "PTID": {
      "type": "string",
      "description": "Original study protocol"
    },
    "SITE": {
      "type": "integer",
      "description": "Site"
    },
    "VISCODE": {
      "type": "string",
      "description": "Visit code"
    },
    "EXAMDATE": {
      "type": "string",
      "format": "date-time",
      "description": "Date"
    },
    "AGE": {
      "type": "number",
      "description": "Age"
    },
    "PTGENDER": {
      "type": "string",
      "enum": [
        "Female",
        "Male"
      ],
