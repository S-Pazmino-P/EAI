{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "RID": {
      "type": "integer",
      "description": "Participant roster ID"
    },
    "COLPROT": {
      "type": "string",
      "enum": [
        "ADNI1",
        "ADNI2",
        "ADNI3",
        "ADNIGO"
      ],
      "description": "Study protocol of data collection"
    },
    "ORIGPROT": {
      "type": "string",
      "enum": [
        "ADNI1",
        "ADNI2",
        "ADNI3",
        "ADNIGO"
      ],
