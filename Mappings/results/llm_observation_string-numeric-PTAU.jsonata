[
  ($.PTAU != null and $string($.PTAU) != "") ? [{
    "resourceType": "Observation",
    "identifier": [{ "system": "http://adni.example.org/fhir/identifier/observation", "value": $.PTID & "-" & $.VISCODE & "-PTAU" }],
    "code": { "coding": [{"system": "http://loinc.org", "code": "79060-0"}], "text": "PTAU" },
    "valueQuantity": { "value": $number($replace($string($.PTAU), /^(<=|>=|<|>)\s*/, "")) },
    "subject": { "identifier": { "system": "http://adni.example.org/fhir/CodeSystem/adni-terms", "type": { "text": "PTID" }, "value": $.PTID } },
    "encounter": { "identifier": { "system": "http://adni.example.org/fhir/identifier/encounter", "value": $.PTID & "-" & $.VISCODE } },
    "effectiveDateTime": $.EXAMDATE
  }] : []
]