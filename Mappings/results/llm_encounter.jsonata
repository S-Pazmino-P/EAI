[
  {
    "resourceType": "Encounter",
    "status": "finished",
    "class": { "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode", "code": "AMB" },
    "subject": {
      "identifier": {
        "system": "http://adni.example.org/fhir/CodeSystem/adni-terms",
        "type": { "text": "PTID" },
        "value": $string($.PTID)
      }
    },
    "identifier": [
      {
        "system": "http://adni.example.org/fhir/identifier/encounter",
        "value": $string($.PTID) & "-" & $.VISCODE
      }
    ],
    "period": { "start": $.EXAMDATE },
    "extension": [
      {
        "url": "http://adni.example.org/fhir/StructureDefinition/adni-protocol",
        "valueCodeableConcept": {
          "coding": [
            {
              "system": "http://adni.example.org/fhir/CodeSystem/adni-terms",
              "code": $.COLPROT
            }
          ]
        }
      },
      {
        "url": "http://adni.example.org/fhir/StructureDefinition/adni-origin",
        "valueCodeableConcept": {
          "coding": [
            {
              "system": "http://adni.example.org/fhir/CodeSystem/adni-terms",
              "code": $.ORIGPROT
            }
          ]
        }
      },
      {
        "url": "http://adni.example.org/fhir/StructureDefinition/adni-site",
        "valueCodeableConcept": {
          "coding": [
            {
              "system": "http://adni.example.org/fhir/CodeSystem/adni-terms",
              "code": $.SITE
            }
          ]
        }
      }
    ]
  }
]